/* 伴夏设计系统：iOS 26 Liquid Glass 风格（浅色）v3
   深色 → 浅色整套翻转（用户钦定 2026-08-31）：背景 #F2F2F7、卡片纯白、
   白磨砂玻璃 chrome、深色文字；Tab 栏白玻璃胶囊 + #007AFF 选中。
   双端共享：Phone 全屏 UIDocument + Quest 世界空间 RT 面板（均为 1080x1920 参考画布）。

   比例换算（关键）：PanelSettings 参考宽度 1080px = iOS 390pt 画布，
   即 1 iOS pt ≈ 2.77 USS px。本表所有尺寸 = iOS HIG 值 × 2.7 取整。
   v1 的观感根因即"把 pt 当 px 用，整体比 iOS 小 2.77 倍"。

   材质铁律（Apple HIG《Materials》）：
   - 玻璃只用于控制层（Tab 栏 / 工具条 / 按钮 / Toast / 输入框）；
     内容层（卡片 / 分组列表）用系统实色（#1C1C1E），不上玻璃。
   - 玻璃厚度 = 顶亮底暗的 1pt 描边（深色模式：顶 0.30 / 侧 0.10 / 底 0.06）。
   - 按压反馈 = 填充变亮 + scale 0.97 + 0.16s ease-out。
   - UI Toolkit 无 backdrop blur，用"半透明暗玻璃 + 描边 + 按压亮态"近似。 */
:root {
    /* 内容层背景（实色，iOS insetGrouped 浅色值） */
    --bg: rgb(242, 242, 247);                 /* #F2F2F7 系统分组底 */
    --bg-elevated: rgb(255, 255, 255);        /* 卡片/分组列表 = 纯白 */
    --bg-card: rgb(255, 255, 255);
    --bg-card-active: rgb(229, 229, 234);     /* #E5E5EA */
    --separator: rgba(60, 60, 67, 0.29);

    /* 文字（iOS 语义色 浅色档） */
    --label: rgb(0, 0, 0);
    --label-secondary: rgba(60, 60, 67, 0.6);
    --label-tertiary: rgba(60, 60, 67, 0.3);

    /* 系统色（浅色档） */
    --tint: rgb(0, 122, 255);                 /* #007AFF */
    --tint-pressed: rgb(0, 98, 204);
    --tint-fill: rgba(0, 122, 255, 0.9);
    --tint-fill-pressed: rgba(0, 86, 180, 0.95);
    --green: rgb(52, 199, 89);                /* #34C759 */
    --red: rgb(255, 59, 48);                  /* #FF3B30 */
    --orange: rgb(255, 149, 0);

    /* Liquid Glass 材质（浅色：白磨砂玻璃） */
    --glass: rgba(120, 120, 128, 0.12);       /* 普通控件填充 */
    --glass-pressed: rgba(120, 120, 128, 0.2);
    --glass-chrome: rgba(255, 255, 255, 0.78); /* 悬浮 chrome（Tab 栏/输入行/pill） */
    --glass-chrome-pressed: rgba(244, 244, 246, 0.95);
    --glass-selected: rgba(0, 0, 0, 0.06);    /* 玻璃上的选中衬底（浅色规范） */
    /* 玻璃描边：顶亮 / 底暗 / 侧微光（浅色模式） */
    --glass-edge-top: rgba(255, 255, 255, 0.9);
    --glass-edge-bottom: rgba(0, 0, 0, 0.08);
    --glass-edge-side: rgba(255, 255, 255, 0.55);
    --glass-edge-top-strong: rgba(255, 255, 255, 0.95);

    /* 圆角（胶囊 = 高度一半；嵌套同心：内层 = 外层 − 内边距） */
    --radius-card: 54px;                      /* 大卡 20pt */
    --radius-group: 28px;                     /* 分组列表 10pt */
    --radius-row-inner: 24px;                 /* 组内控件同心近似 */
    --radius-capsule: 999px;

    /* 字号阶梯（iOS pt × 2.7） */
    --fs-large-title: 92px;   /* 34pt */
    --fs-title1: 76px;        /* 28pt */
    --fs-title2: 60px;        /* 22pt */
    --fs-title3: 54px;        /* 20pt */
    --fs-body: 46px;          /* 17pt（正文基准） */
    --fs-callout: 43px;       /* 16pt */
    --fs-subhead: 40px;       /* 15pt */
    --fs-footnote: 35px;      /* 13pt */
    --fs-caption: 32px;       /* 12pt */
    --fs-tab: 30px;           /* 11pt（Tab 标签） */

    /* 触控基准 */
    --touch: 120px;           /* 44pt 最小触控区 */
}

/* ── 屏幕根 ── */
.screen-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}
.screen {
    flex-grow: 1;
    background-color: var(--bg);
}

/* ── 导航栏（iOS 大标题）── */
.nav-bar {
    flex-shrink: 0;
    padding: 40px 54px 20px 54px;
}
.nav-title {
    font-size: var(--fs-large-title);
    -unity-font-style: bold;
    color: var(--label);
    margin-bottom: 10px;
}
.nav-subtitle {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
}

/* ── 分组列表（iOS insetGrouped：实色内容层，圆角 10pt≈28px）── */
.group {
    background-color: var(--bg-elevated);
    border-radius: var(--radius-group);
    margin: 26px 54px;
    padding: 6px 0;
}
.settings-back {
    height: 220px;           /* 100 顶部安全留白 + 120 点击热区 */
    flex-shrink: 0;
    align-items: flex-end;   /* 文字落在热区底部（居中会跑到留白里） */
    padding-left: 54px;
    padding-bottom: 20px;
    margin: 0;
}
.settings-back:hover {
    background-color: rgba(120, 120, 128, 0.08);
}
.settings-back-label {
    font-size: var(--fs-body);
    color: var(--tint);
}
.group-header {
    flex-shrink: 0;
    font-size: var(--fs-footnote);
    color: var(--label-secondary);
    text-transform: uppercase;
    margin: 48px 70px 16px 70px;
}
.row {
    flex-direction: row;
    align-items: center;
    min-height: var(--touch);
    padding: 22px 43px;
    border-bottom-width: 2px;                  /* 1pt 分隔线（画布比例） */
    border-bottom-color: var(--separator);
}
.row:last-child {
    border-bottom-width: 0;
}
.row-label {
    font-size: var(--fs-body);
    color: var(--label);
    flex-grow: 1;
    margin-right: 22px;
}
.row-value {
    font-size: var(--fs-body);
    color: var(--label-secondary);
    margin-right: 16px;
}
.row-chevron {
    font-size: var(--fs-body);
    color: var(--label-tertiary);
}

/* ── 按钮（玻璃胶囊；主按钮 tinted glass）── */
.btn {
    height: var(--touch);
    border-radius: 60px;
    background-color: var(--glass);
    border-top-width: 3px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    justify-content: center;
    align-items: center;
    margin: 16px 54px;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.btn:active {
    background-color: var(--glass-pressed);
    border-top-color: rgba(255, 255, 255, 0.10);
    scale: 0.97;
}
.btn-label {
    font-size: var(--fs-body);
    color: var(--label);
}
.btn-primary {
    background-color: var(--tint-fill);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.15);
}
.btn-primary .btn-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.btn-primary:active {
    background-color: var(--tint-fill-pressed);
}
.btn-danger .btn-label {
    color: var(--red);
}
.btn-small {
    height: 96px;
    border-radius: 48px;
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    justify-content: center;
    align-items: center;
    padding: 0 43px;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.btn-small:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.btn-small .btn-label {
    font-size: var(--fs-subhead);
    color: var(--tint);
}
.btn-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 16px 54px;
}
.btn-row .btn-small {
    flex-grow: 1;
    margin: 0 10px;
    padding: 0 22px;
}
.btn-row .btn-small:first-child {
    margin-left: 0;
}
.btn-row .btn-small:last-child {
    margin-right: 0;
}

/* ── 胶囊 pill（场景悬浮工具条 / 快捷短语）── */
.pill {
    border-radius: var(--radius-capsule);
    background-color: var(--glass-chrome);
    border-top-width: 3px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    padding: 26px 48px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.pill:active {
    background-color: var(--glass-chrome-pressed);
    scale: 0.97;
}
.pill.active {
    background-color: rgba(0, 122, 255, 0.35);
    border-top-color: rgba(0, 122, 255, 0.45);
}
.pill.active .pill-label {
    color: var(--tint-pressed);
    -unity-font-style: bold;
}
.pill-label {
    font-size: var(--fs-subhead);
    color: var(--label);
}
.chip {
    border-radius: var(--radius-capsule);
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    padding: 20px 36px;
    margin: 0 12px 12px 0;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.chip:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.chip-label {
    font-size: var(--fs-subhead);
    color: var(--label);
}
.chips-row {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    margin: 12px 54px;
}

/* ── 开关（iOS Switch：OFF 轨道实色 #39393D）── */
.switch-knob {
    width: 140px;
    height: 85px;
    border-radius: var(--radius-capsule);
    background-color: rgba(120, 120, 128, 0.16);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.06);
    justify-content: flex-end;
    padding: 6px;
}
.switch-knob.on {
    background-color: var(--green);
}
.switch-thumb {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-capsule);
    background-color: rgb(255, 255, 255);
}

/* ── Tab 栏（iOS 26 浅色悬浮玻璃胶囊：白色磨砂 + 深色文字，21pt inset）── */
.tab-bar {
    flex-direction: row;
    flex-shrink: 0;                            /* 长内容页（设置）不挤压底栏 */
    height: 152px;                            /* 56pt */
    margin: 0 56px 56px 56px;                 /* 21pt inset */
    border-radius: 76px;                      /* 胶囊 = 高/2 */
    background-color: rgba(255, 255, 255, 0.92);   /* 浅色 Liquid Glass */
    border-top-width: 3px;    border-top-color: rgba(255, 255, 255, 0.6);
    border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0.06);
    border-left-width: 2px;   border-left-color: rgba(255, 255, 255, 0.4);
    border-right-width: 2px;  border-right-color: rgba(255, 255, 255, 0.4);
}
.tab-item {
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 66px;                      /* 与 tab-bar 同心：76 − 10 */
    margin: 10px 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.tab-item.selected {
    background-color: rgba(0, 0, 0, 0.06);    /* 浅色胶囊上的选中衬底 */
    border-color: rgba(0, 0, 0, 0.04);
}
.tab-label {
    font-size: var(--fs-tab);
    color: rgba(0, 0, 0, 0.6);                /* 浅色玻璃上的深色文字 */
}
.tab-item.selected .tab-label {
    color: rgb(0, 122, 255);                  /* 选中 = tint（白底用 #007AFF） */
    -unity-font-style: bold;
}

/* ── 分段控件（容器玻璃胶囊 + 选中白色胶囊，同心）── */
.seg {
    flex-direction: row;
    background-color: var(--glass);
    border-radius: 44px;                      /* 高 88 → 胶囊 */
    padding: 6px;
}
.seg-item {
    flex-grow: 1;
    height: 76px;                             /* 88 − 2×6 padding */
    border-radius: 38px;                      /* 同心：76/2 */
    justify-content: center;
    align-items: center;
    margin: 0 3px;
    transition-property: background-color;
    transition-duration: 0.16s;
}
.seg-item-label {
    font-size: var(--fs-footnote);
    color: var(--label);
}
.seg-item.selected {
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.06);
}
.seg-item.selected .seg-item-label {
    color: var(--label);
    -unity-font-style: bold;
}

/* ── 数字键盘（配对码）── */
/*
 * The four rows are structural. Key height/radius/font-size are injected from
 * the measured panel height by BanxiaUiShell; USS only defines the layout
 * contract and the visual state.
 */
.numpad {
    flex-direction: column;
    align-items: stretch;
    margin: 20px 24px;
}
.numpad-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    margin-bottom: 12px;
}
.numpad-row:last-child {
    margin-bottom: 0;
}
.numpad-key {
    width: auto;
    min-width: 0;
    height: auto;
    min-height: 0;
    border-radius: 0;
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    justify-content: center;
    align-items: center;
    margin: 0 8px;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.numpad-key:first-child {
    margin-left: 0;
}
.numpad-key:last-child {
    margin-right: 0;
}
.numpad-key:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.numpad-key-label {
    width: 100%;
    height: 100%;
    font-size: 60px;
    color: var(--label);
    -unity-text-align: middle-center;
}
.code-dots {
    flex-direction: row;
    justify-content: center;
    margin: 26px 0;
}
.code-dot {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background-color: rgba(120, 120, 128, 0.4);
    margin: 0 22px;
}
.code-dot.filled {
    background-color: var(--label);
}

/* ── 卡片（内容层实色 #1C1C1E，圆角 20pt≈54px）── */
.card {
    background-color: var(--bg-card);
    border-radius: var(--radius-card);
    padding: 38px 43px;
    margin: 16px 54px;
    flex-direction: row;
    align-items: center;
}
.card-title {
    font-size: var(--fs-body);
    -unity-font-style: bold;
    color: var(--label);
}
.card-subtitle {
    font-size: var(--fs-footnote);
    color: var(--label-secondary);
    margin-top: 8px;
}
.card-body {
    flex-grow: 1;
    margin-right: 26px;
}
.card-action {
    border-radius: var(--radius-capsule);
    background-color: var(--tint);
    padding: 22px 43px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.card-action:active {
    background-color: var(--tint-pressed);
    scale: 0.97;
}
.card-action-label {
    font-size: var(--fs-subhead);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.card-badge {
    font-size: var(--fs-caption);
    color: var(--green);
    margin-top: 8px;
}
.card-more {
    border-radius: var(--radius-capsule);
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    padding: 16px 32px;
    margin-left: 22px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.card-more:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.card-more-label {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
}
.card-confirm {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.card-confirm-text {
    font-size: var(--fs-footnote);
    color: var(--label);
    flex-grow: 1;
    margin-right: 22px;
}

/* ── 快捷入口网格（首页）── */
.tile-grid {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 16px 54px;
}
.tile {
    width: 47.5%;
    height: 170px;
    border-radius: 40px;
    background-color: var(--glass);
    border-top-width: 3px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    padding: 26px 32px;
    margin-bottom: 20px;
    justify-content: flex-end;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.tile:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.tile-title {
    font-size: var(--fs-body);
    -unity-font-style: bold;
    color: var(--label);
}
.tile-sub {
    font-size: var(--fs-caption);
    color: var(--label-secondary);
    margin-top: 6px;
}

/* ── 输入框（表单 rounded-rect 10pt≈28px；聊天行为胶囊，见下）── */
.field {
    background-color: rgba(118, 118, 128, 0.16);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 28px;
    min-height: var(--touch);
    padding: 22px 38px;
    margin: 16px 54px;
    font-size: var(--fs-body);
    color: var(--label);
}
.field:focus {
    border-color: var(--tint);
    background-color: rgba(118, 118, 128, 0.22);
}

/* ── 状态行 / Toast ── */
.status-line {
    font-size: var(--fs-footnote);
    color: var(--label-secondary);
    margin: 10px 54px;
    white-space: normal;
}
/* Toast：iOS 惯例 = Tab 栏上方悬浮玻璃胶囊 */
.toast {
    background-color: var(--glass-chrome);
    border-top-width: 3px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    border-radius: var(--radius-capsule);
    padding: 26px 54px;
    align-self: center;
    position: absolute;
    bottom: 230px;                            /* Tab 栏（152 + 56 边距）之上 */
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}
.toast-label {
    font-size: var(--fs-subhead);
    color: var(--label);
}

/* ── 进度条 ── */
.progress-track {
    height: 16px;
    border-radius: 8px;
    background-color: rgba(120, 120, 128, 0.3);
    margin: 22px 54px;
    overflow: hidden;
}
.progress-fill {
    height: 100%;
    background-color: var(--tint);
    border-radius: 8px;
}

/* ── 列表 / 空态 ── */
.scroll {
    flex-grow: 1;
}
.empty-hint {
    justify-content: center;
    align-items: center;
    padding: 110px 88px;
}
.empty-hint-label {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── 场景悬浮工具条 ── */
.scene-toolbar {
    position: absolute;
    bottom: 60px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}
.scene-toolbar .pill {
    margin: 0 14px;
    padding: 22px 40px;
}
.scene-toolbar .pill-label {
    font-size: var(--fs-subhead);
}

/* ── 对话页（钉底输入行，Messages 式）── */
.chat-scroll {
    flex-grow: 1;
    padding: 22px 54px;
}
/* ── 对话页：未连接引导卡（效果 02 稿：白卡居中引导）── */
.chat-guide-card {
    background-color: var(--bg-card);
    border-radius: 36px;
    border-width: 2px;
    border-color: var(--glass-edge-bottom);
    padding: 60px 48px;
    margin: 30px 54px;
    align-items: center;
}
.chat-guide-title {
    font-size: var(--fs-title3);
    color: var(--label);
    -unity-font-style: bold;
    margin-bottom: 18px;
}
.chat-guide-body {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
    white-space: normal;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}
/* ── 对话页：伴夏状态卡（名字 + 实时状态 + 头像点）── */
.chat-status-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-card);
    border-radius: 36px;
    border-width: 2px;
    border-color: var(--glass-edge-bottom);
    padding: 26px 34px;
    margin: 12px 54px 6px 54px;
}
.chat-status-avatar {
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: var(--tint-fill);
    margin-right: 26px;
    flex-shrink: 0;
}
.chat-status-texts {
    flex-grow: 1;
}
.chat-status-name {
    font-size: var(--fs-headline);
    color: var(--label);
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.chat-status-sub {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
    white-space: normal;
}
.bubble-user {
    background-color: var(--tint-fill);
    border-radius: 54px;
    padding: 26px 38px;
    margin: 10px 0 10px 190px;
    align-self: flex-end;
}
.bubble-reply {
    background-color: var(--bg-card);
    border-radius: 54px;
    padding: 26px 38px;
    margin: 10px 190px 10px 0;
    align-self: flex-start;
}
.bubble-text {
    font-size: var(--fs-callout);
    color: var(--label);
    white-space: normal;
}
.bubble-user .bubble-text {
    color: rgb(255, 255, 255);
}
.chat-input-bar {
    flex-shrink: 0;
    flex-direction: row;
    padding: 16px 54px 28px 54px;
    align-items: center;
}
.chat-input-bar .field {
    flex-grow: 1;
    margin: 0;
    border-radius: 60px;                      /* 聊天输入行 = 胶囊（Messages 式） */
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
}
.chat-input-bar .field:focus {
    border-color: var(--tint);
}
.chat-camera {
    width: var(--touch);
    height: var(--touch);
    border-radius: 60px;
    background-color: var(--glass);
    border-top-width: 2px;    border-top-color: var(--glass-edge-top);
    border-bottom-width: 2px; border-bottom-color: var(--glass-edge-bottom);
    border-left-width: 2px;   border-left-color: var(--glass-edge-side);
    border-right-width: 2px;  border-right-color: var(--glass-edge-side);
    justify-content: center;
    align-items: center;
    margin-left: 16px;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.chat-camera:active {
    background-color: var(--glass-pressed);
    scale: 0.97;
}
.chat-camera-label {
    font-size: var(--fs-callout);
    color: var(--tint);
}
.chat-send {
    width: var(--touch);
    height: var(--touch);
    border-radius: 60px;
    background-color: var(--tint-fill);
    border-top-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.35);
    justify-content: center;
    align-items: center;
    margin-left: 16px;
    transition-property: background-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.chat-send:active {
    background-color: var(--tint-fill-pressed);
    scale: 0.97;
}
.chat-send-label {
    font-size: var(--fs-body);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* ═══ 同框三模式（虚拟场景 / 视频通话 / 同框现实 AR）═══ */

/* 模式选择 / 环境 Sheet 遮罩（scrim：复用为弹层遮罩，0.4 与 QA 断言亮度阈值一致） */
.cp-backdrop {
    position: absolute; inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

/* 模式选择 / 环境 Sheet 本体 */
.cp-sheet {
    position: absolute; left: 0; right: 0; bottom: 0;
    background-color: var(--bg-elevated);
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-top-width: 2px;
    border-top-color: var(--glass-edge-top);
    padding: 20px 42px 34px;
}
.cp-grabber {
    height: 8px; width: 120px; border-radius: 4px;
    background-color: var(--glass);
    align-self: center; margin-bottom: 14px;
}
.cp-title {
    font-size: var(--fs-title3);
    color: var(--label);
    -unity-font-style: bold;
    margin-bottom: 14px;
}

/* 模式卡 */
.cp-card {
    background-color: var(--bg-card);
    border-radius: 28px;
    border-width: 2px;
    border-color: var(--glass-edge-bottom);
    padding: 16px 26px;
    margin-bottom: 12px;
}
.cp-card.current {
    border-width: 2px;
    border-color: var(--tint);              /* iOS 蓝 2px 轻量描边（替代大块蓝底） */
}
.cp-card.disabled {
    opacity: 0.45;
}
.cp-card-head {
    flex-direction: row; align-items: center; margin-bottom: 6px;
}
.cp-card-title {
    font-size: var(--fs-body);
    color: var(--label);
    -unity-font-style: bold;
}
.cp-card-tag {
    font-size: var(--fs-caption);
    color: var(--tint);
    margin-left: 20px;
}
.cp-card-desc {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
    white-space: normal;
}

/* 环境 chips */
.cp-chip-row {
    flex-direction: row; flex-wrap: wrap; margin-bottom: 26px;
}
.cp-chip {
    background-color: var(--glass);
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.06);
    color: var(--label-secondary);
    font-size: var(--fs-subhead);
    padding: 18px 42px;
    margin-right: 18px; margin-bottom: 18px;
}
.cp-chip.current {
    background-color: var(--glass-selected);
    border-color: rgba(0, 122, 255, 0.45);
    color: var(--tint);
    -unity-font-style: bold;
}
/* AR 放置提示卡（玻璃，不拦截点击）*/
.ar-hint {
    position: absolute; left: 150px; right: 150px; top: 68%;
    background-color: var(--glass-chrome);
    border-radius: 32px;
    border-width: 2px;
    border-top-color: var(--glass-edge-top-strong);
    border-bottom-color: var(--glass-edge-bottom);
    padding: 30px 36px;
    align-items: center;
}
.ar-hint-title {
    font-size: var(--fs-body);
    color: var(--label);
    -unity-font-style: bold;
    margin-bottom: 10px;
}
.ar-hint-sub {
    font-size: var(--fs-subhead);
    color: var(--label-secondary);
}

/* 视频通话 chrome */
.call-chrome {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    justify-content: space-between;
}
.call-top {
    flex-direction: row; align-items: center;
    background-color: var(--glass-chrome);
    border-radius: 50px;
    border-width: 2px;
    border-top-color: var(--glass-edge-top-strong);
    border-bottom-color: var(--glass-edge-bottom);
    padding: 22px 40px;
    margin: 56px 54px 0;
}
.call-dot {
    width: 24px; height: 24px; border-radius: 12px;
    background-color: var(--green);
    margin-right: 22px;
}
.call-name {
    font-size: var(--fs-body);
    color: var(--label);
    -unity-font-style: bold;
}
.call-timer {
    font-size: var(--fs-body);
    color: var(--label-secondary);
    margin-left: auto;
    -unity-font-style: bold;
}
.call-subtitle {
    background-color: var(--glass-chrome);
    border-radius: 40px;
    border-width: 2px;
    border-top-color: var(--glass-edge-top-strong);
    border-bottom-color: var(--glass-edge-bottom);
    color: var(--label);
    font-size: var(--fs-callout);
    -unity-text-align: middle-center;
    padding: 24px 44px;
    margin: 0 90px;
    white-space: normal;
    max-visible-lines: 2;
    text-overflow: ellipsis;
}
.call-controls {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 240px;
}
.call-btn {
    background-color: var(--glass-chrome);
    border-radius: 56px;
    border-width: 2px;
    border-top-color: var(--glass-edge-top-strong);
    border-bottom-color: var(--glass-edge-bottom);
    color: var(--label);
    font-size: var(--fs-subhead);
    padding: 34px 52px;
    margin: 0 22px;
}
.call-hangup {
    background-color: var(--red);
    color: rgb(255, 255, 255);
    border-color: rgba(0, 0, 0, 0.08);
    -unity-font-style: bold;
}
.cp-note {
    font-size: var(--fs-caption);
    color: var(--label-tertiary);
    white-space: normal;
}
.cp-more {
    color: var(--tint);
    font-size: var(--fs-subhead);
    -unity-font-style: bold;
    align-self: center;
    margin-top: 8px;
    padding: 18px 42px;
}
