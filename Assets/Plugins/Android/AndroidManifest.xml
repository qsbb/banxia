<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- Phone form needs INTERNET explicitly: on Quest it is injected by the
         Meta OpenXR SDK, but the phone build boots no XR loader. RECORD_AUDIO
         is declared for the voice-conversation runtime permission request.
         CAMERA backs the phone-exclusive single-frame camera snapshot
         ("看看我今天穿的"): without the declaration the runtime request is
         auto-denied and WebCamTexture never delivers frames.
         REQUEST_INSTALL_PACKAGES backs the in-app GitHub-Releases updater
         (downloads go through the system DownloadManager, whose content URIs
         the package installer can open without any FileProvider of our own). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
